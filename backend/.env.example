DATABASE_URL=postgres://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/todo_app
JWT_SECRET=replace-with-a-long-random-string
PORT=5000

# ---- AI (Gemini + Grok) – never commit real keys ----
# Gemini key: https://aistudio.google.com  ->  Get API key
GEMINI_API_KEY=
# Grok key:   https://console.x.ai          ->  API keys
XAI_API_KEY=
# Optional: model names (defaults shown). Check each console for the current fast model.
GEMINI_MODEL=gemini-2.5-flash
XAI_MODEL=grok-3-mini
# Optional
APP_TIMEZONE=Asia/Kolkata
AI_CALLS_PER_MINUTE=20
AI_TIMEOUT_MS=30000
# LOCAL TESTING ONLY: fake AI replies without keys (never counted in the comparison, ignored in production)
AI_MOCK=false
